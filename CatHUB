-- 1. ESP Highlight
local ESPEnabled = false
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESPFolder"
ESPFolder.Parent = ParentTarget

local activeHighlights = {}

local function createESP(character)
    if activeHighlights[character] then return end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 182, 193)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Parent = ESPFolder

    activeHighlights[character] = highlight
end

local function removeESP(character)
    if activeHighlights[character] then
        activeHighlights[character]:Destroy()
        activeHighlights[character] = nil
    end
end

local function setupPlayerESP(player)
    if player == LocalPlayer then return end

    player.CharacterAdded:Connect(function(char)
        if ESPEnabled then createESP(char) end
    end)

    player.CharacterRemoving:Connect(function(char)
        removeESP(char)
    end)

    if player.Character and ESPEnabled then
        createESP(player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayerESP(p) end
Players.PlayerAdded:Connect(setupPlayerESP)

local ESPToggle = Tabs.Visual:AddToggle("ESP", { Title = "Enable ESP", Default = false })
ESPToggle:OnChanged(function(Value)
    ESPEnabled = Value
    if ESPEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then createESP(p.Character) end
        end
    else
        for char, _ in pairs(activeHighlights) do removeESP(char) end
    end
end)

-- 2. FPS Booster & Proximity Culling
local FPSBoosterEnabled = false
local storedProperties = {}
local cullingDistance = 80

task.spawn(function()
    while true do
        task.wait(0.15)
        if FPSBoosterEnabled then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local myPos = hrp.Position
                for _, part in ipairs(Workspace:GetDescendants()) do
                    if part:IsA("BasePart") and not part:IsDescendantOf(char) then
                        local dist = (part.Position - myPos).Magnitude
                        if dist > cullingDistance then
                            part.LocalTransparencyModifier = 1
                        else
                            part.LocalTransparencyModifier = 0
                        end
                    end
                end
            end
        end
    end
end)

local FPSBoosterToggle = Tabs.Visual:AddToggle("FPSBooster", { Title = "Enable FPS Booster", Default = false })
FPSBoosterToggle:OnChanged(function(Value)
    FPSBoosterEnabled = Value

    if FPSBoosterEnabled then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("Texture") then
                storedProperties[obj] = obj.Transparency
                obj.Transparency = 1
            elseif obj:IsA("SpecialMesh") then
                storedProperties[obj] = obj.TextureId
                obj.TextureId = ""
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                storedProperties[obj] = obj.Enabled
                obj.Enabled = false
            end
        end

        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    for _, child in ipairs(head:GetChildren()) do
                        if child:IsA("Decal") and child.Name == "face" then
                            storedProperties[child] = child.Transparency
                            child.Transparency = 1
                        end
                    end
                end
            end
        end

        storedProperties["Ambient"] = Lighting.Ambient
        storedProperties["OutdoorAmbient"] = Lighting.OutdoorAmbient
        storedProperties["Brightness"] = Lighting.Brightness

        Lighting.Ambient = Color3.fromRGB(80, 60, 75)
        Lighting.OutdoorAmbient = Color3.fromRGB(80, 60, 75)
        Lighting.Brightness = 1.5
    else
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.LocalTransparencyModifier = 0
            end
        end

        for obj, prop in pairs(storedProperties) do
            if typeof(obj) == "Instance" and obj.Parent then
                if obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = prop
                elseif obj:IsA("SpecialMesh") then
                    obj.TextureId = prop
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = prop
                end
            end
        end

        if storedProperties["Ambient"] then
            Lighting.Ambient = storedProperties["Ambient"]
            Lighting.OutdoorAmbient = storedProperties["OutdoorAmbient"]
            Lighting.Brightness = storedProperties["Brightness"]
        end

        storedProperties = {}
    end
end)

