    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(1, 0, 0, 28)
    NotifFrame.Position = UDim2.new(0, 0, 0, -35)
    NotifFrame.BackgroundColor3 = Color3.fromRGB(46, 34, 42)
