        local spinSpeed = 90
        local targetLeft = 90
        local accumulatedLeft = 0
        while accumulatedLeft < targetLeft and AutoWallhopEnabled do
            local dt = RunService.RenderStepped:Wait()
            local step = spinSpeed * dt * 60
            if accumulatedLeft + step > targetLeft then step = targetLeft - accumulatedLeft end
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(step), 0)
            accumulatedLeft = accumulatedLeft + step
        end

        local targetRight = 90
        local accumulatedRight = 0
        while accumulatedRight < targetRight and AutoWallhopEnabled do
            local dt = RunService.RenderStepped:Wait()
            local step = spinSpeed * dt * 60
            if accumulatedRight + step > targetRight then step = targetRight - accumulatedRight end
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-step), 0)
            accumulatedRight = accumulatedRight + step
        end
    end)
end)

