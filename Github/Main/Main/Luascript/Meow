	isAimbotEnabled = not isAimbotEnabled
	
	local targetPos
	local targetColor
	local bgTargetColor
	local strokeTargetColor
	
	if isAimbotEnabled then
		targetPos = UDim2.new(1, -21, 0.5, -9)
		targetColor = Color3.fromRGB(255, 180, 255)
		bgTargetColor = Color3.fromRGB(75, 25, 120)
		strokeTargetColor = Color3.fromRGB(220, 100, 255)
	else
		targetPos = UDim2.new(0, 3, 0.5, -9)
		targetColor = Color3.fromRGB(160, 80, 230)
		bgTargetColor = Color3.fromRGB(30, 18, 45)
		strokeTargetColor = Color3.fromRGB(130, 50, 200)
	end
	
	TweenService:Create(toggleKnob, tweenInfo, {Position = targetPos, BackgroundColor3 = targetColor}):Play()
	TweenService:Create(toggleBg, tweenInfo, {BackgroundColor3 = bgTargetColor}):Play()
	TweenService:Create(toggleBgStroke, tweenInfo, {Color = strokeTargetColor}):Play()
end)

-- Face Nearby Player Aimbot Loop Execution
RunService.RenderStepped:Connect(function()
	if not isAimbotEnabled then return end
	
	local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoidRootPart then return end
	
	local closestPlayer = nil
	local shortestDistance = math.huge
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local targetHRP = p.Character.HumanoidRootPart
			local distance = (humanoidRootPart.Position - targetHRP.Position).Magnitude
			
			if distance < shortestDistance then
				shortestDistance = distance
				closestPlayer = p
			end
		end
	end
	
	if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local targetHRP = closestPlayer.Character.HumanoidRootPart
		local lookPosition = Vector3.new(targetHRP.Position.X, humanoidRootPart.Position.Y, targetHRP.Position.Z)
		
		-- Instantly locks facial orientation to target without walking movement
		humanoidRootPart.CFrame = CFrame.new(humanoidRootPart.Position, lookPosition)
	end
end)
