    Tabs.Visual:AddSection("Bomb Tooling (AnkleBreak Mode)")

    local bombHolderHighlights = {}
    Tabs.Visual:AddToggle("BombESPToggle", {
        Title = "Enable Bomb Holder ESP",
        Description = "Highlights whoever is currently holding the bomb in red",
        Default = false,
        Callback = function(Value)
            BombESPEnabled = Value
            if BombESPEnabled then
                task.spawn(function()
                    while BombESPEnabled do
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p.Character then
                                local hasBomb = false
                                
                                if p:FindFirstChild("Backpack") then
                                    for _, item in ipairs(p.Backpack:GetChildren()) do
                                        if item.Name:lower():find("bomb") then hasBomb = true end
                                    end
                                end
                                for _, item in ipairs(p.Character:GetChildren()) do
                                    if item:IsA("Tool") and item.Name:lower():find("bomb") then hasBomb = true end
                                end
                                
                                for _, desc in ipairs(p.Character:GetDescendants()) do
                                    local dName = desc.Name:lower()
                                    if dName:find("bomb") or dName:find("timer") or dName:find("c4") then
                                        hasBomb = true
                                        break
                                    end
                                end
                                
                                if hasBomb then
                                    if not bombHolderHighlights[p] then
                                        local hl = Instance.new("Highlight")
                                        hl.Adornee = p.Character
                                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                                        hl.FillTransparency = 0.2
                                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                        hl.Parent = ESPFolder
                                        bombHolderHighlights[p] = hl
                                    end
                                else
                                    if bombHolderHighlights[p] then
                                        bombHolderHighlights[p]:Destroy()
                                        bombHolderHighlights[p] = nil
                                    end
                                end
                            end
                        end
                        task.wait(0.5)
                    end
                end)
            else
                for p, hl in pairs(bombHolderHighlights) do
                    if hl then hl:Destroy() end
                end
                bombHolderHighlights = {}
            end
        end
    })

    Tabs.Visual:AddSection("Smoothness Booster")

    local FPSBoosterEnabled = false
    local storedProperties = {}

    Tabs.Visual:AddToggle("FPSBoosterToggle", {
        Title = "Enable Anti-Lag / FPS Booster",
        Description = "Removes heavy textures, shadows, and particles for max smoothness",
        Default = false,
        Callback = function(Value)
            FPSBoosterEnabled = Value
            if FPSBoosterEnabled then
                pcall(function()
                    Lighting.GlobalShadows = false
                    Lighting.Brightness = 2
                    Lighting.FogEnd = 999999
                end)
                
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                        storedProperties[obj] = obj.Transparency
                        obj.Transparency = 1
                    elseif obj:IsA("SpecialMesh") then
                        storedProperties[obj] = obj.TextureId
                        obj.TextureId = ""
                    elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                        storedProperties[obj] = obj.Enabled
                        obj.Enabled = false
                    elseif obj:IsA("MeshPart") then
                        storedProperties[obj] = obj.TextureID
                        obj.TextureID = ""
                    elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("CharacterMesh") then
                        storedProperties[obj] = obj.Parent
                        obj.Parent = nil
                    elseif obj:IsA("Explosion") then
                        storedProperties[obj] = obj.BlastPressure
                        obj.BlastPressure = 0
                    end
                end
                storedProperties["Ambient"] = Lighting.Ambient
                Lighting.Ambient = Color3.fromRGB(120, 120, 120)
            else
                pcall(function()
                    Lighting.GlobalShadows = true
                end)
                for obj, prop in pairs(storedProperties) do
                    if typeof(obj) == "Instance" then
                        if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                            obj.Transparency = prop
                        elseif obj:IsA("SpecialMesh") then
                            obj.TextureId = prop
                        elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                            obj.Enabled = prop
                        elseif obj:IsA("MeshPart") then
                            obj.TextureID = prop
                        elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("CharacterMesh") then
                            if typeof(prop) == "Instance" then
                                obj.Parent = prop
                            end
                        end
                    end
                end
                if storedProperties["Ambient"] then
                    Lighting.Ambient = storedProperties["Ambient"]
                end
                storedProperties = {}
            end
        end
    })

    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char)
            if ESPEnabled then createESP(char) end
        end)
        player.CharacterRemoving:Connect(function(char)
            removeESP(char)
            if bombHolderHighlights[player] then
                bombHolderHighlights[player]:Destroy()
                bombHolderHighlights[player] = nil
            end
        end)
    end)

