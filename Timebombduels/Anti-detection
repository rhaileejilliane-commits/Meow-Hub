    local function applyHitboxToPlayer(p)
        if p == LocalPlayer then return end
        local char = p.Character
        if not char or not isR6(char) then return end
        
        local partsToModify = {"HumanoidRootPart", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
        
        if not fakeBodyParts[p] then
            fakeBodyParts[p] = {}
            local containerFolder = Instance.new("Folder")
            containerFolder.Name = "FakeBodyContainer"
            containerFolder.Parent = char
            fakeBodyParts[p]["Container"] = containerFolder

            for _, partName in ipairs(partsToModify) do
                local realPart = char:FindFirstChild(partName)
                if realPart then
                    local clone = realPart:Clone()
                    clone.Name = "Fake_" .. partName
                    clone.Anchored = true
                    clone.CanCollide = true
                    clone.Transparency = realPart.Transparency
                    
                    for _, child in ipairs(clone:GetChildren()) do
                        if child:IsA("Weld") or child:IsA("Motor6D") or child:IsA("Script") then
                            child:Destroy()
                        end
                    end
                    
                    clone.Parent = containerFolder
                    fakeBodyParts[p][partName] = clone
                end
            end

            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Clothing") or child:IsA("ShirtGraphic") or (child:IsA("Accessory") and not containerFolder:FindFirstChild(child.Name)) then
                    local clonedAccessory = child:Clone()
                    clonedAccessory.Parent = containerFolder
                end
            end
        end
        
        for _, partName in ipairs(partsToModify) do
            local part = char:FindFirstChild(partName)
            if part then
                if not originalPartSizes[part] then
                    originalPartSizes[part] = {Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide}
                end
                part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                part.Transparency = 1
                part.CanCollide = false
            end
        end
    end

    local function resetHitboxForPlayer(p)
        local char = p.Character
        if char then
            for _, partName in ipairs({"HumanoidRootPart", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
                local part = char:FindFirstChild(partName)
                if part and originalPartSizes[part] then
                    part.Size = originalPartSizes[part].Size
                    part.Transparency = originalPartSizes[part].Transparency
                    part.CanCollide = originalPartSizes[part].CanCollide
                    originalPartSizes[part] = nil
                end
            end
        end
        removeFakeBody(p)
    end

