local lastTouchTimes = {}
local touchCooldown = 1

RunService.Stepped:Connect(function()
    if not AutoFlickEnabled or isFlicking then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            if pRoot then
                local dist = (hrp.Position - pRoot.Position).Magnitude
                if dist <= 5 then
                    local currentTime = os.clock()
                    if not lastTouchTimes[p] or (currentTime - lastTouchTimes[p] > touchCooldown) then
                        lastTouchTimes[p] = currentTime
                        isFlicking = true

                        showFlickNotification(p.Name)

                        task.spawn(function()
                            local spinSpeed = 120
                            local accumulatedLeft = 0
                            while accumulatedLeft < 90 and AutoFlickEnabled do
                                local dt = RunService.RenderStepped:Wait()
                                local step = spinSpeed * dt * 60
                                if accumulatedLeft + step > 90 then
                                    step = 90 - accumulatedLeft
                                end
                                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(step), 0)
                                accumulatedLeft = accumulatedLeft + step
                            end

                            local accumulatedRight = 0
                            while accumulatedRight < 90 and AutoFlickEnabled do
                                local dt = RunService.RenderStepped:Wait()
                                local step = spinSpeed * dt * 60
                                if accumulatedRight + step > 90 then
                                    step = 90 - accumulatedRight
                                end
                                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(-spinSpeed), 0)
                                accumulatedRight = accumulatedRight + step
                            end
                            isFlicking = false
                        end)
                    end
                end
            end
        end
    end
end)

