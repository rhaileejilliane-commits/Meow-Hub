    ExpiredFrame.Parent = ExpiredGui

    local ExpCorner = Instance.new("UICorner")
    ExpCorner.CornerRadius = UDim.new(0, 12)
    ExpCorner.Parent = ExpiredFrame

    local ExpStroke = Instance.new("UIStroke")
    ExpStroke.Color = Color3.fromRGB(255, 100, 100)
    ExpStroke.Thickness = 1.5
    ExpStroke.Parent = ExpiredFrame

    local ExpIcon = Instance.new("TextLabel")
    ExpIcon.Size = UDim2.new(1, 0, 0, 30)
    ExpIcon.Position = UDim2.new(0, 0, 0, 16)
    ExpIcon.BackgroundTransparency = 1
    ExpIcon.Text = "⚠️"
    ExpIcon.TextColor3 = Color3.fromRGB(255, 100, 100)
    ExpIcon.Font = Enum.Font.Arcade
    ExpIcon.TextSize = 22
    ExpIcon.Parent = ExpiredFrame

    local ExpText = Instance.new("TextLabel")
    ExpText.Size = UDim2.new(1, -20, 0, 50)
    ExpText.Position = UDim2.new(0, 10, 0, 55)
    ExpText.BackgroundTransparency = 1
