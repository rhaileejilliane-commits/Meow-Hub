local function SwitchPage(pageName)
    for name, page in pairs(Pages) do
        page.Visible = (name == pageName)
    end
    for name, btn in pairs(NavButtons) do
        local iconObj = btn:FindFirstChild("IconLabel")
        if name == pageName then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(70, 45, 60)}):Play()
            if iconObj then
                TweenService:Create(iconObj, TweenInfo.new(0.2), {TextColor3 = Themes[CurrentTheme].Primary}):Play()
            end
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(42, 30, 39)}):Play()
            if iconObj then
                TweenService:Create(iconObj, TweenInfo.new(0.2), {TextColor3 = Themes[CurrentTheme].TextMuted}):Play()
            end
        end
    end
end

