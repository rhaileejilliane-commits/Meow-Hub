-- ====================================================================
-- 1-Week Expiration Check System (Persistent via HttpService / TeleportData or tick)
-- ====================================================================
local EXPIRATION_DURATION = 7 * 24 * 60 * 60 -- 1 Week in seconds

-- Use a unique key for the player's local storage/registry if supported, 
-- or fallback to a session-persistent table / os.time check. 
local firstLaunchTime = nil
local success, savedTime = pcall(function()
    if readfile and writefile and isfile and isfile("MeowHub_License.txt") then
        return tonumber(readfile("MeowHub_License.txt"))
    end
    return nil
end)

if success and savedTime then
    firstLaunchTime = savedTime
else
    firstLaunchTime = os.time()
    pcall(function()
        if writefile then
            writefile("MeowHub_License.txt", tostring(firstLaunchTime))
        end
    end)
end

local function getRemainingTime()
    local elapsedTime = os.time() - firstLaunchTime
    local timeLeft = EXPIRATION_DURATION - elapsedTime
    return math.max(0, timeLeft)
end

-- If expired immediately upon execution, show expired screen and halt
if getRemainingTime() <= 0 then
    local ExpiredGui = Instance.new("ScreenGui")
    ExpiredGui.Name = "MeowHubExpiredGui"
    ExpiredGui.ResetOnSpawn = false
    ExpiredGui.Parent = ParentTarget

    local ExpiredFrame = Instance.new("Frame")
