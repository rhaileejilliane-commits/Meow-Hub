local function minimizeGUI()
    local startPos = MainFrame.AbsolutePosition
    local tween = TweenService:Create(
        MainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = UDim2.new(0, 42, 0, 42),
            Position = UDim2.new(0, startPos.X, 0, startPos.Y),
            BackgroundTransparency = 1
        }
    )
    tween:Play()
    tween.Completed:Connect(function()
        MainFrame.Visible = false
        MainFrame.Size = UDim2.new(0, 640, 0, 380)
        MainFrame.Position = UDim2.new(0.5, -320, 0.5, -190)
        MainFrame.BackgroundTransparency = 0.05
        MinimizedBar.Visible = true
    end)
end

local function restoreGUI()
    MinimizedBar.Visible = false
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 42, 0, 42)
    MainFrame.BackgroundTransparency = 1

    local tween = TweenService:Create(
        MainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {
            Size = UDim2.new(0, 640, 0, 380),
            Position = UDim2.new(0.5, -320, 0.5, -190),
            BackgroundTransparency = 0.05
        }
    )
    tween:Play()
end

CloseBtn.MouseButton1Click:Connect(minimizeGUI)
