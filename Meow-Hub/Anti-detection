-- Fixed Bomb ESP: Scans players and workspace tools/accessories/attributes for the bomb carrier
local bombHolderHighlights = {}
Tabs.Visual:AddToggle("BombESPToggle", {
    Title = "Enable Bomb Holder ESP",
    Description = "Highlights whoever is currently holding the bomb in red",
    Default = false,
    Callback = function(Value)
        BombESPEnabled = Value
        if BombESPEnabled then
            task.spawn(function()
                while BombESPEnabled do
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character then
                            local hasBomb = false
                            
                            -- Method 1: Check if character or backpack contains a bomb item/tool
                            if p:FindFirstChild("Backpack") then
                                for _, item in ipairs(p.Backpack:GetChildren()) do
                                    if item.Name:lower():find("bomb") then hasBomb = true end
                                end
                            end
                            for _, item in ipairs(p.Character:GetChildren()) do
                                if item:IsA("Tool") and item.Name:lower():find("bomb") then hasBomb = true end
                            end
                            
                            -- Method 2: Check standard game attributes or tags for bomb holder state
                            for _, desc in ipairs(p.Character:GetDescendants()) do
                                local dName = desc.Name:lower()
                                if dName:find("bomb") or dName:find("timer") or dName:find("c4") then
                                    hasBomb = true
                                    break
                                end
                            end
                            
                            if hasBomb then
                                if not bombHolderHighlights[p] then
                                    local hl = Instance.new("Highlight")
                                    hl.Adornee = p.Character
                                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                                    hl.FillTransparency = 0.2
                                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                    hl.Parent = ESPFolder
                                    bombHolderHighlights[p] = hl
                                end
                            else
                                if bombHolderHighlights[p] then
                                    bombHolderHighlights[p]:Destroy()
                                    bombHolderHighlights[p] = nil
                                end
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        else
            for p, hl in pairs(bombHolderHighlights) do
                if hl then hl:Destroy() end
            end
            bombHolderHighlights = {}
        end
    end
})

