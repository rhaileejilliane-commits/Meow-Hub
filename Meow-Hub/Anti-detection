local FPSBoosterEnabled = false
local storedProperties = {}

Tabs.Visual:AddToggle("FPSBoosterToggle", {
    Title = "Enable Anti-Lag / FPS Booster",
    Description = "Removes heavy textures, shadows, and particles for max smoothness",
    Default = false,
    Callback = function(Value)
        FPSBoosterEnabled = Value
        if FPSBoosterEnabled then
            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.Brightness = 2
                Lighting.FogEnd = 999999
            end)
            
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    storedProperties[obj] = obj.Transparency
                    obj.Transparency = 1
                elseif obj:IsA("SpecialMesh") then
                    storedProperties[obj] = obj.TextureId
                    obj.TextureId = ""
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    storedProperties[obj] = obj.Enabled
                    obj.Enabled = false
                elseif obj:IsA("MeshPart") then
                    storedProperties[obj] = obj.TextureID
                    obj.TextureID = ""
                elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("CharacterMesh") then
                    storedProperties[obj] = obj.Parent
                    obj.Parent = nil
                elseif obj:IsA("Explosion") then
                    storedProperties[obj] = obj.BlastPressure
                    obj.BlastPressure = 0
                end
            end
            storedProperties["Ambient"] = Lighting.Ambient
            Lighting.Ambient = Color3.fromRGB(120, 120, 120)
        else
            pcall(function()
                Lighting.GlobalShadows = true
            end)
            for obj, prop in pairs(storedProperties) do
                if typeof(obj) == "Instance" then
                    if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                        obj.Transparency = prop
                    elseif obj:IsA("SpecialMesh") then
                        obj.TextureId = prop
                    elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                        obj.Enabled = prop
                    elseif obj:IsA("MeshPart") then
                        obj.TextureID = prop
                    elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("CharacterMesh") then
                        if typeof(prop) == "Instance" then
                            obj.Parent = prop
                        end
                    end
                end
            end
            if storedProperties["Ambient"] then
                Lighting.Ambient = storedProperties["Ambient"]
            end
            storedProperties = {}
        end
    end
})

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
